  "permanent_human_review_topics": ["gmv", "sales", "revenue", "ranking", "external_results", "rules", "eligibility", "latest_news", "case_study", "company_comparison", "person_comparison", "media", "image", "video", "clip", "legal", "advertising", "high_risk_claim"],
  "content_pillars_percent": {"tiktok_shop_beginner": 20, "creator_monetization": 20, "product_research": 15, "video_research": 20, "live_commerce": 10, "case_data": 10, "market_news": 5},
  "audience_percent": {"beginner": 40, "creator": 40, "common": 20},
  "cta_phases": {
    "1": {"line_enabled": false, "cta_ratio_percent": 0, "requires_human_review": true},
    "2": {"line_enabled": true, "cta_ratio_percent_min": 20, "cta_ratio_percent_max": 30, "minimum_beginner_posts": 8, "minimum_creator_posts": 8, "minimum_repeated_pain_count": 3},
    "3": {"line_enabled": true, "tracked_segments": ["beginner", "creator"]},
