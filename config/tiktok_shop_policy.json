  },
  "credentials": {"handle_env": "THREADS_HANDLE_TIKTOK_SHOP", "user_id_env": "THREADS_USER_ID_TIKTOK_SHOP", "access_token_env": "THREADS_ACCESS_TOKEN_TIKTOK_SHOP"},
  "schedule": {"timezone": "Asia/Tokyo", "posts_per_day": 2, "prepare_slots_jst": ["08:45", "17:45"], "publish_slots_jst": ["10:45", "19:45"]},
  "metrics": {"windows_hours": [24, 72, 168], "unavailable_value": null},
  "pdca": {"account_scope": "tiktok_shop", "cross_account_learning": false, "minimum_sample_size": 15, "auto_apply": false}
