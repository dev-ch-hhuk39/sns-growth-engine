{
  "schema_version": "beauty_voice_corpus_v1",
  "style_profile_version": "chadult_beauty_voice_v1",
  "account_id": "beauty_account",
  "display_name": "Chadult Beauty Voice",
  "derivation_policy": "aggregate_style_features_only_never_copy_a_person",
  "voice_reference_source_ids": [
    "src_ba_tt_cand_001",
    "src_ba_tt_cand_002",
    "src_ba_tt_cand_003",
    "src_ba_tt_cand_004",
    "src_ba_tt_cand_005",
    "src_ba_tt_cand_006",
    "src_ba_tt_cand_007",
    "src_ba_x_cand_001",
    "src_ba_x_cand_002",
    "src_ba_x_cand_003"
  ],
  "bounded_reference_collection": {
    "enabled": true,
    "reference_only": true,
    "x_read_only": true,
    "max_posts_per_source_scan": 30,
    "max_new_posts_per_source_per_run": 10,
    "max_total_new_posts_per_run": 50,
    "allow_media_reuse": false,
    "allow_download": false,
    "allow_cut": false,
    "allow_upload": false,
    "allow_x_post": false
  },
  "corpus_policy": {
    "minimum_source_accounts": 5,
    "maximum_source_accounts": 10,
    "minimum_posts_per_source": 10,
    "maximum_posts_per_source": 30,
    "target_account_id": "beauty_account",
    "content_reference_separated": true,
    "copy_verbatim_examples": false
  },
  "style_fingerprint": {
    "allowed_emojis": ["🥺", "✨", "🤍", "🫶🏻", "😭", "💭"],
    "emoji_count_min": 0,
    "emoji_count_max": 4,
    "paragraph_count_min": 3,
    "paragraph_count_max": 6,
    "average_line_length_max": 48,
    "full_stop_ratio_max": 0.25,
    "exclamation_count_max": 1,
    "humanity_markers": [
      "〜なんだけど",
      "なんだけど",
      "これ結構大事",
      "結構大事",
      "個人的には",
      "ほんとに",
      "意外と",
      "な気がする",
      "気がする",
      "してみてほしい"
    ],
    "soft_endings": ["だよね", "なんだよね", "かも", "気がする", "てみて", "てみてほしい", "で大丈夫"],
    "formal_or_ad_phrases": ["と見ています", "提案します", "検証します", "ご購入ください", "今すぐチェック"],
    "minimum_humanity_marker_count": 2,
    "minimum_soft_ending_count": 1,
    "minimum_style_score": 85
  },
  "account_isolation": {
    "strict": true,
    "cross_account_learning": false,
    "blocked_source_accounts": ["night_scout", "liver_manager"],
    "blocked_foreign_context_terms": ["時給", "ノルマ", "客層", "体入", "ライバー事務所", "初見コメント", "配信時間"]
  }
}
