{
  "schema_version": 1,
  "notes": "Active reference discovery is Threads/TikTok/X/YouTube. Threads uses pinned threads-cli crawler reads, logged-out persisted GraphQL, then public Playwright with a circuit breaker. Physical media reuse is governed separately by permission and media_platform_policy.",
  "routes": {
    "threads.profile_posts": {
      "primary": "threads_cli_public",
      "fallbacks": [
        "threads_logged_out_graphql",
        "threads_public_screen"
      ],
      "shadow": [],
      "cooldown_seconds": 900,
      "circuit_failure_threshold": 3
    },
    "tiktok.profile_posts": {
      "primary": "tiktok_public_embed",
      "fallbacks": [
        "tiktok_gallery_dl"
      ],
      "shadow": [],
      "cooldown_seconds": 900
    },
    "x.profile_posts": {
      "primary": "x_gallery_dl",
      "fallbacks": [],
      "shadow": [],
      "cooldown_seconds": 900,
      "circuit_failure_threshold": 3
    },
    "youtube.channel_videos": {
      "primary": "yt_dlp",
      "fallbacks": [],
      "shadow": [],
      "cooldown_seconds": 900
    },
    "youtube.transcript": {
      "primary": "youtube_transcript_api",
      "fallbacks": [
        "yt_dlp_subtitles",
        "local_faster_whisper"
      ],
      "shadow": [],
      "cooldown_seconds": 1800
    },
    "youtube.comments": {
      "primary": "youtube_comment_downloader",
      "fallbacks": [],
      "shadow": [],
      "cooldown_seconds": 1800
    },
    "video.post_detail": {
      "primary": "yt_dlp_post_detail",
      "fallbacks": [],
      "shadow": [],
      "cooldown_seconds": 900
    },
    "content.understanding": {
      "primary": "github_models",
      "fallbacks": [],
      "shadow": [],
      "cooldown_seconds": 300
    },
    "content.caption": {
      "primary": "github_models",
      "fallbacks": [],
      "shadow": [],
      "cooldown_seconds": 300
    },
    "content.semantic_alignment": {
      "primary": "local_semantic_alignment",
      "fallbacks": [
        "sentence_transformers_multilingual"
      ],
      "shadow": [],
      "cooldown_seconds": 300
    },
    "research.trends": {
      "primary": "local_trend_aggregator",
      "fallbacks": [],
      "shadow": [
        "agent_reach",
        "last30days_skill"
      ],
      "cooldown_seconds": 3600
    }
  },
  "backend_roles": {
    "yt_dlp": "PRIMARY_PHYSICAL_X_YOUTUBE_POST_DETAIL",
    "tiktok_public_embed": "PRIMARY_PUBLIC_PROFILE_DISCOVERY",
    "tiktok_public_playwright": "DEPRECATED_INACTIVE",
    "tiktok_gallery_dl": "FALLBACK_METADATA_ONLY",
    "threads_browser_session": "DEPRECATED_INACTIVE",
    "threads_public_playwright": "DEPRECATED_INACTIVE",
    "threads_cli_public": "PRIMARY_ANONYMOUS_CRAWLER_SSR",
    "threads_logged_out_graphql": "FALLBACK_LOGGED_OUT_PERSISTED_QUERY",
    "threads_public_screen": "FINAL_PUBLIC_PLAYWRIGHT_FALLBACK",
    "threads_public_http": "PRIMARY",
    "threads_oembed_detail": "PRIMARY_TOKENLESS_INDIVIDUAL_POST_DETAIL",
    "threads_search_index": "FALLBACK_CANDIDATE_DISCOVERY_REVALIDATED",
    "threads_graph_public_discovery": "OPTIONAL_AUTH_OFFICIAL_PUBLIC_DISCOVERY",
    "x_gallery_dl": "PRIMARY_METADATA_DISCOVERY",
    "youtube_transcript_api": "PRIMARY",
    "youtube_comment_downloader": "PRIMARY",
    "threads_public_comments": "PRIMARY",
    "yt_dlp_post_detail": "PRIMARY",
    "github_models": "PRIMARY",
    "local_semantic_alignment": "PRIMARY",
    "sentence_transformers_multilingual": "OPTIONAL_FALLBACK",
    "yt_dlp_subtitles": "FALLBACK",
    "local_faster_whisper": "FALLBACK",
    "local_trend_aggregator": "PRIMARY",
    "agent_reach": "ANALYSIS_ONLY",
    "last30days_skill": "ANALYSIS_ONLY",
    "firecrawl": "OPTIONAL_FALLBACK",
    "hasdata": "AUDIT_ONLY_NO_LICENSE",
    "zeeshan_threads_scraper": "ANALYSIS_ONLY",
    "vdite_threads_scraper": "OPTIONAL_FALLBACK_UPSTREAM_HEALTH_REQUIRED",
    "galihkjaya_threadscraper": "ANALYSIS_ONLY"
  },
  "limits": {
    "threads_profile_posts_per_source": 5,
    "youtube_tiktok_posts_per_source": 10,
    "source_requests_serial": true
  }
}
